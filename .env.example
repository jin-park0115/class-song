# backend/.env 로 복사해서 사용한다. 실제 비밀번호는 커밋하지 않는다.
DATABASE_URL=postgresql+psycopg://jukebox:CHANGE_ME@localhost:5432/jukebox

MPD_HOST=127.0.0.1
MPD_PORT=6600
# MPD_PASSWORD=
MPD_TIMEOUT_SECONDS=5

# 같은 Wi-Fi 내부망 HTTP 운영 전제. HTTPS 적용 시 true 로 바꾼다.
COOKIE_SECURE=false
SESSION_TTL_STUDENT_HOURS=168
SESSION_TTL_ADMIN_HOURS=12

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=10

# system_settings.max_volume 이 비어 있을 때의 볼륨 상한
DEFAULT_MAX_VOLUME=40
